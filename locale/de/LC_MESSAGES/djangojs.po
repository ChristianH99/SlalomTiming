msgstr "Tab drücken, um %(email)s zu vervollständigen"

msgid ""
"Matches <strong>%(name)s</strong>%(club)s on %(reason)s — licence "
"%(license)s. <a href=\"%(url)s\">Jump to this participant</a>"
msgstr ""
"Übereinstimmung mit <strong>%(name)s</strong>%(club)s bei %(reason)s — "
"Lizenz %(license)s. <a href=\"%(url)s\">Zu diesem Teilnehmer springen</a>"

msgid ""
"<strong>Possible duplicate.</strong> This looks like someone already "
"registered. You can continue anyway, cancel, or open the existing record:"
msgstr ""
"<strong>Möglicherweise ein Duplikat.</strong> Diese Person scheint bereits "
"registriert zu sein. Sie können trotzdem fortfahren, abbrechen oder den "
"vorhandenen Datensatz öffnen:"

msgid "Could not remove the logo (%(error)s)."
msgstr "Logo konnte nicht entfernt werden (%(error)s)."

msgid "Building…"
msgstr "Wird erstellt…"

msgid "Could not build the sample PDF (%(error)s)."
msgstr "Beispiel-PDF konnte nicht erstellt werden (%(error)s)."

msgid "Drag to reorder"
msgstr "Ziehen zum Umordnen"

msgid "Drag the tied competitors into order, then set their ranks."
msgstr ""
"Ziehen Sie die punktgleichen Teilnehmer in die richtige Reihenfolge und "
"legen Sie dann ihre Plätze fest."

msgid "Every rank needs a number."
msgstr "Jeder Platz benötigt eine Zahl."

msgid "The first competitor must be rank %(start)s."
msgstr "Der erste Teilnehmer muss Platz %(start)s sein."

msgid "Ranks must go in order — a tie keeps the lower number."
msgstr ""
"Die Plätze müssen der Reihe nach vergeben werden — bei Gleichstand gilt die "
"niedrigere Zahl."

msgid "Could not save."
msgstr "Konnte nicht gespeichert werden."

msgid "Add a row for an upcoming starter"
msgstr "Eine Zeile für einen kommenden Starter hinzufügen"

msgid "Remove this row"
msgstr "Diese Zeile entfernen"

msgid "Double-click to type a time"
msgstr "Doppelklicken, um eine Zeit einzugeben"

msgid "Manual"
msgstr "Manuell"

msgid "Light barrier"
msgstr "Lichtschranke"

msgid "%(kind)s · drag to pair or to the Ignored panel · double-click to edit"
msgstr ""
"%(kind)s · ziehen zum Zuordnen oder auf das Feld „Ignoriert“ · zum "
"Bearbeiten doppelklicken"

msgid "No starter with this bib is registered (kept anyway)."
msgstr "Kein Starter mit dieser Startnummer registriert (trotzdem behalten)."

msgid "Drag onto a run's slot · double-click to restore"
msgstr "Auf den Platz eines Laufs ziehen · zum Wiederherstellen doppelklicken"

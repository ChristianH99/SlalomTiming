msgid "Settings for “%(name)s” saved."
msgstr "Einstellungen für „%(name)s“ gespeichert."

msgid "That type is still in use and can't be deleted."
msgstr "Dieser Typ wird noch verwendet und kann nicht gelöscht werden."

#, python-format
msgid "“%(name)s” can’t be added more than once."
msgstr "„%(name)s“ kann nicht mehr als einmal hinzugefügt werden."

msgid "Only one class can be assigned to this participant."
msgstr "Diesem Teilnehmer kann nur eine Klasse zugewiesen werden."

msgid "Co-driver first name"
msgstr "Vorname Beifahrer"

msgid "Co-driver last name"
msgstr "Nachname Beifahrer"

msgid "Street address"
msgstr "Straße"

msgid "ZIP code"
msgstr "PLZ"

msgid "City"
msgstr "Ort"

msgid "Bib number"
msgstr "Startnummer"

msgid ""
"Optional — assigns this participant a bib for the current competition right "
"away."
msgstr ""
"Optional — weist diesem Teilnehmer sofort eine Startnummer für den aktuellen"
" Wettbewerb zu."

msgid "No competition is currently selected, so a bib can't be assigned yet."
msgstr ""
"Derzeit ist kein Wettbewerb ausgewählt, daher kann noch keine Startnummer "
"zugewiesen werden."

msgid "This bib number is already taken in the current competition."
msgstr "Diese Startnummer ist im aktuellen Wettbewerb bereits vergeben."


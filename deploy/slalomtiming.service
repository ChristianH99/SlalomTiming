# systemd unit for Slalom Timing (Linux venue box).
#
#   sudo cp deploy/slalomtiming.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now slalomtiming
#   journalctl -u slalomtiming -f          # the live log
#
# Adjust User/WorkingDirectory/EnvironmentFile to the install location.

[Unit]
Description=Slalom Timing (Daphne ASGI server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=slalom
Group=slalom
WorkingDirectory=/srv/slalomtiming

# DJANGO_SECRET_KEY, DJANGO_DEBUG=False, DJANGO_ALLOWED_HOSTS, … — see .env.example.
EnvironmentFile=/srv/slalomtiming/.env

# EXACTLY ONE PROCESS, AND ONE THREAD OF CONTROL. The channel layer that carries
# the live-update nudges is in-memory, the CP540 reader is a module-level thread,
# and the event loop those post onto belongs to this process. A second worker gets
# its own copies and silently splits the event in half — browsers attached to the
# wrong process simply stop updating. config/singleinstance.py enforces this with a
# lock file, so a second start fails rather than half-works; do not add workers here.
ExecStart=/usr/bin/env uv run daphne -b 127.0.0.1 -p 8000 config.asgi:application

Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

# The database is the event: don't let a restart loop hide a failure.
StartLimitBurst=5
StartLimitIntervalSec=60

# Hardening (the app only needs its own directory).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/slalomtiming

[Install]
WantedBy=multi-user.target

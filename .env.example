# Deployment configuration for Slalom Timing. Run-book: DEPLOYMENT.md
#
# Copy to `.env` and fill in for a live deployment. These are read from the
# PROCESS ENVIRONMENT (config/settings.py uses os.environ) — Django does not load
# this file automatically. Make them available to the server one of these ways:
#   - export them in the shell before `runserver`/`daphne`, or
#   - a systemd unit:  EnvironmentFile=/path/to/.env
#   - a Docker/Compose `env_file:` / `environment:` block
#
# `.env` is gitignored — never commit real secrets.

# ----- Core (required in production) -----

# Django secret key. Generate a fresh one:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# REQUIRED with DEBUG=False — the app refuses to start without it. There is no
# fallback for a deployment on purpose: settings.py used to carry a literal key,
# and a key in a public repository is a key everyone has (anything signed with it,
# a session cookie included, is forgeable by anyone who read the file). A
# *development* checkout now mints its own into DATA_DIR/.secret_key, which is
# gitignored and never used once DEBUG is off.
DJANGO_SECRET_KEY=change-me-to-a-freshly-generated-key

# Must be False in any real deployment. Turns on the HTTPS/security hardening
# block in settings.py and hides error detail.
DJANGO_DEBUG=False

# Comma-separated hostnames/IPs this site serves (required when DEBUG is False).
DJANGO_ALLOWED_HOSTS=timing.example.org

# Comma-separated https:// origins for authenticated form POSTs from the live host.
DJANGO_CSRF_TRUSTED_ORIGINS=https://timing.example.org

# ----- Timing device door -----

# Shared secret an unauthenticated HTTP timing device must send as the
# "X-Device-Token" header on POST /timing/signal/. Leave blank if only the
# browser Simulator (which uses the logged-in session) or the CP540 reader
# thread feed signals. Generate:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TIMING_DEVICE_TOKEN=

# ----- Files -----

# Everything the app WRITES: db.sqlite3, media/, run/server.lock and the
# unrecorded-times log. Defaults to the project directory, which is what a
# checkout wants. Set it when the code lives somewhere that gets replaced —
# the packaged Windows installer (build/) points it at
# %LOCALAPPDATA%\SlalomTiming\data so an upgrade can't take an event with it.
# SLALOM_DATA_DIR=/srv/slalomtiming/data

# Where `manage.py collectstatic` writes the files WhiteNoise serves. Defaults to
# `staticfiles/` in the project. collectstatic must run on every release — with
# DEBUG=False, nothing serves /static/ until it has.
# DJANGO_STATIC_ROOT=/srv/slalomtiming/staticfiles

# Uploaded results-PDF logos. Defaults to `media/` in the project.
# DJANGO_MEDIA_ROOT=/srv/slalomtiming/media

# Django serves /media/ itself by default (a handful of small logos). Set False
# when the reverse proxy is configured to serve MEDIA_ROOT instead.
# DJANGO_SERVE_MEDIA=False

# ----- TLS (the default is HTTPS; read DEPLOYMENT.md before changing it) -----

# The ONE switch that runs this app without TLS. Everything on the venue network can
# then read passwords and session cookies off the air, including devices you don't
# control, so this is a decision and not a convenience: set up deploy/Caddyfile (a
# local CA, no internet needed) or Tailscale instead. Setting it prints a warning on
# every command and in the server log. The retired DJANGO_SECURE_SSL_REDIRECT /
# DJANGO_SECURE_COOKIES escape hatches now refuse to start; this replaces both.
# DJANGO_ALLOW_PLAIN_HTTP=True

# How long a browser remembers "this host is HTTPS only" (HSTS). The default of 300 s
# is deliberately short: the pin cannot be revoked before it expires, and a venue
# hostname served with a local CA gets reused. Raise it (and add
# DJANGO_HSTS_PRELOAD=True) only with a stable public domain.
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_HSTS_PRELOAD=True

# ----- Content-Security-Policy -----

# Send the CSP as Report-Only: nothing is blocked, violations appear in the
# browser console. Use it to find out what a new page broke, then turn it off.
# Do NOT deploy with this set — a report-only policy stops nothing.
# DJANGO_CSP_REPORT_ONLY=True

# ----- Logging -----

# Where the rotating application/security log is written (three files of 2 MB).
# Defaults to <data dir>/logs. This is the record of who signed in, who was
# refused, and any timing signal the database would not take — on a packaged
# install the console window that would otherwise hold it is closed at the end of
# the day, so the file is the only copy.
# DJANGO_LOG_DIR=/srv/slalomtiming/logs

# INFO records logins; WARNING records only failures and refusals.
# DJANGO_LOG_LEVEL=INFO

# ----- Sessions and login -----

# How long a signed-in session lasts, in hours (default 12 — one event day).
# DJANGO_SESSION_HOURS=12

# Failed logins allowed per username+IP before that pair is locked out, and for how
# many seconds. Raise the first or lower the second if an operator locks themselves
# out mid-event; the counters also clear on a server restart.
# DJANGO_LOGIN_MAX_ATTEMPTS=10
# Failures allowed from one address across *all* usernames, which is what stops a
# single host working through a list of accounts.
# DJANGO_LOGIN_MAX_ATTEMPTS_PER_HOST=50
# DJANGO_LOGIN_LOCKOUT_SECONDS=300

# ----- Single-process rule -----
# The live-update channel layer, the CP540 reader thread and its event loop are all
# per-process, so exactly one server process may serve an event; a second start is
# refused (config/singleinstance.py). Only set this after swapping CHANNEL_LAYERS
# for a cross-process backend such as channels_redis.
# DJANGO_ALLOW_MULTIPLE_SERVERS=1

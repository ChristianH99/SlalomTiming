# Deployment configuration for Slalom Timing.
#
# Copy to `.env` and fill in for a live deployment. These are read from the
# PROCESS ENVIRONMENT (config/settings.py uses os.environ) — Django does not load
# this file automatically. Make them available to the server one of these ways:
#   - export them in the shell before `runserver`/`daphne`, or
#   - a systemd unit:  EnvironmentFile=/path/to/.env
#   - a Docker/Compose `env_file:` / `environment:` block
#
# `.env` is gitignored — never commit real secrets.

# ----- Core (required in production) -----

# Django secret key. Generate a fresh one:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-freshly-generated-key

# Must be False in any real deployment. Turns on the HTTPS/security hardening
# block in settings.py and hides error detail.
DJANGO_DEBUG=False

# Comma-separated hostnames/IPs this site serves (required when DEBUG is False).
DJANGO_ALLOWED_HOSTS=timing.example.org

# Comma-separated https:// origins for authenticated form POSTs from the live host.
DJANGO_CSRF_TRUSTED_ORIGINS=https://timing.example.org

# ----- Timing device door -----

# Shared secret an unauthenticated HTTP timing device must send as the
# "X-Device-Token" header on POST /timing/signal/. Leave blank if only the
# browser Simulator (which uses the logged-in session) or the CP540 reader
# thread feed signals. Generate:  uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TIMING_DEVICE_TOKEN=

# ----- Optional HTTPS overrides (defaults are secure) -----
# Only set these to run a deployment on plain HTTP (e.g. a trusted LAN). The
# secure default (unset) assumes HTTPS.
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SECURE_COOKIES=False
# DJANGO_HSTS_SECONDS=31536000
